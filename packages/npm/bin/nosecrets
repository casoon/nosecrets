#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const { platform, arch } = process;

const PLATFORMS = {
  win32: {
    x64: ['npm-win32-x64', 'nosecrets.exe'],
  },
  darwin: {
    x64: ['npm-darwin-x64', 'nosecrets'],
    arm64: ['npm-darwin-arm64', 'nosecrets'],
  },
  linux: {
    x64: ['npm-linux-x64', 'nosecrets'],
    arm64: ['npm-linux-arm64', 'nosecrets'],
  },
};

const target = PLATFORMS?.[platform]?.[arch];

if (!target) {
  console.error(
    'The nosecrets npm package does not ship with a prebuilt binary for your platform (' +
      platform +
      '/' +
      arch +
      ').'
  );
  process.exitCode = 1;
} else {
  const binPath = path.resolve(__dirname, '..', 'vendor', target[0], target[1]);

  if (!fs.existsSync(binPath)) {
    console.error('The packaged nosecrets binary is missing at ' + binPath + '.');
    process.exitCode = 1;
  } else {
    const result = spawnSync(binPath, process.argv.slice(2), {
      shell: false,
      stdio: 'inherit',
    });

    if (result.error) {
      throw result.error;
    }

    process.exitCode = result.status;
  }
}
